# Database
DATABASE_URL=postgresql+asyncpg://comment_manager:comment_manager@localhost:5432/comment_manager
DATABASE_URL_SYNC=postgresql://comment_manager:comment_manager@localhost:5432/comment_manager

# JWT
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI - Chat (DeepSeek)
AI_CHAT_API_KEY=sk-your-deepseek-key
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-v4-flash

# AI - Chat 备用（主 provider 失败时自动切换；Key 留空则不启用备用）
# 推荐填入 DashScope Key（与 AI_EMBEDDING_API_KEY 相同）
AI_CHAT_BACKUP_API_KEY=
AI_CHAT_BACKUP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_BACKUP_MODEL=qwen-turbo

# AI - Embedding (Qwen / DashScope)
AI_EMBEDDING_API_KEY=sk-your-qwen-key
AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_MODEL=text-embedding-v3

# DingTalk
DINGTALK_WEBHOOK_URL=

# Crawler
CRAWLER_INTERVAL_MINUTES=120

# Proxy（访问 Steam 等海外接口，填代理地址如 http://127.0.0.1:7897，留空则不使用）
STEAM_PROXY=

# 小黑盒 Cookie（爬取游戏评价所需，游戏页面需要登录）
# 获取方式：登录 xiaoheihe.cn → 浏览器 DevTools Console → 输入 document.cookie → 复制粘贴到此处
XIAOHEIHE_COOKIE=

# Discord Bot Token（抓取 Discord 频道消息所需）
# 获取方式：https://discord.com/developers/applications → 选择应用 → Bot → Token
# 注意：需在 Developer Portal 开启 Message Content Intent，Bot 需加入目标服务器
DISCORD_BOT_TOKEN=

# QQ 群消息（NapCat / LagRange OneBot v11 HTTP API）
# NapCat 已用 Docker 部署（见 docs/SETUP.md「NapCat（Docker 部署）」），用小号登录
# QQ_NAPCAT_URL：NapCat HTTP 监听地址，Docker 版映射到 http://127.0.0.1:3000
# QQ_ACCESS_TOKEN：NapCat/LagRange 配置的 access_token，未设置则留空
QQ_NAPCAT_URL=http://127.0.0.1:3000
QQ_ACCESS_TOKEN=
# @ 以下 QQ 号的群消息无条件入库，逗号分隔，可填多个运营者/管理员的 QQ 号
QQ_AT_ALWAYS_INCLUDE=

# NapCat 掉线自动重启看门狗（应对腾讯风控频繁踢号，掉线后自动 docker restart 恢复）
# 需后端以宿主机进程方式运行（能执行 docker 命令）。启用前请确认容器名正确。
NAPCAT_WATCHDOG_ENABLED=false
NAPCAT_CONTAINER_NAME=napcat
# 恢复在线后私聊通知的管理员 QQ（0 则不发恢复私聊）
NAPCAT_ADMIN_QQ=0
# 需扫码时钉钉告警里给出的 WebUI 地址
NAPCAT_WEBUI_URL=http://127.0.0.1:6099
# 重启后冷却分钟数（期内不再检测/重启）/ 24h 内自动重启上限 / 轮询间隔秒
NAPCAT_RESTART_COOLDOWN_MINUTES=10
NAPCAT_RESTART_DAILY_LIMIT=6
NAPCAT_POLL_INTERVAL_SECONDS=60
# 注意：「需扫码」告警走钉钉带外通道（号离线时 QQ 发不出消息），需配置上方 DINGTALK_WEBHOOK_URL

# ZenTao BUG上报（dump.om.dianhun.cn）
# 优先使用 ZENTAO_COOKIE（格式：PHPSESSID=xxx; user_name=xxx; user_key=xxx; product_id=xxx）
# 若 cookie 留空，则用 USERNAME/PASSWORD 自动 Playwright 登录 AMS SSO
ZENTAO_URL=http://dump.om.dianhun.cn
ZENTAO_USERNAME=
ZENTAO_PASSWORD=
ZENTAO_PRODUCT_ID=
ZENTAO_COOKIE=
ZENTAO_SYNC_INTERVAL=60

# BUG上报 异地推送 Token（远程主机和本地爬虫双方都需配置成同一值）
# 远程主机：设置后启用 POST /api/bugreports/_push（接收外部推送）
# 本地爬虫：用同一 Token 推送数据
# 建议用随机字符串（如 openssl rand -hex 32）
BUG_PUSH_TOKEN=

# 本地推送服务的 HTTP 触发地址（仅远程主机需配置）
# 设置后，前端"手动同步"按钮会转发到这里，让本地服务立刻跑一轮
# 留空 → 走单机模式（用本机 ZenTao 凭据）
# 例：LOCAL_PUSHER_URL=http://192.168.216.45:9000
LOCAL_PUSHER_URL=
